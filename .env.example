DATABASE_PATH=./data/hideki.sqlite
# Required outside localhost: protects UI and API using HTTP Basic (user: hideki).
APP_PASSWORD=
# Encrypt server-stored provider credentials; generate: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=
AI_BASE_URL=http://127.0.0.1:31415/v1
AI_API_KEY=
AI_MODEL=auto:coding
# Source contract: POST {url,filters} -> profile; POST /discover {filters} -> {profiles:[...]}
PROFILE_PROVIDER_URL=
PROFILE_PROVIDER_KEY=
# Outreach contract documented in README. Never configured automatically.
OUTREACH_PROVIDER_URL=
OUTREACH_PROVIDER_KEY=
