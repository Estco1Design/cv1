{
  "name": "hideki-sales-agent",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/production-smoke.ts",
    "instagram:login": "node --env-file-if-exists=.env.local --import tsx scripts/instagram-login.ts",
    "agent:verify": "node --env-file-if-exists=.env.local --import tsx scripts/agent-verify.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "next": "^15.5.12",
    "papaparse": "^5.5.3",
    "playwright": "1.64.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
